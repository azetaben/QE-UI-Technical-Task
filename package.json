{
  "name": "govuk-holiday-entitlement-ui-tests",
  "version": "1.0.0",
  "private": true,
  "description": "GOV.UK holiday entitlement UI tests with Playwright, Cucumber and TypeScript",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/local-app.cjs start",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.cjs\" test-options.ts cucumber.cjs eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/*.cjs\" test-options.ts cucumber.cjs eslint.config.mjs",
    "test:unit": "node scripts/run-node-tests.cjs tests/unit",
    "test:framework": "node scripts/run-node-tests.cjs tests/framework",
    "check:steps": "node scripts/validate-step-definitions.cjs && node scripts/validate-step-coverage.cjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run check:steps",
    "test": "cucumber-js --config cucumber.cjs \"src/test/features/**/*.feature\"",
    "test:staging": "cross-env ENV=staging cucumber-js --config cucumber.cjs \"src/test/features/**/*.feature\"",
    "test:smoke": "cucumber-js --config cucumber.cjs --profile smoke \"src/test/features/**/*.feature\"",
    "test:contract": "cross-env HAR=replay cucumber-js --config cucumber.cjs --profile contract \"src/test/features/**/*.feature\"",
    "test:contract:record": "cross-env HAR=record cucumber-js --config cucumber.cjs --profile contract \"src/test/features/**/*.feature\"",
    "test:dry-run": "cucumber-js --config cucumber.cjs --profile dry-run \"src/test/features/**/*.feature\"",
    "test:all:dry-run": "cucumber-js --config cucumber.cjs --profile all \"src/test/features/**/*.feature\"",
    "test:failed": "node scripts/rerun.cjs",
    "test:parallel": "cucumber-js --config cucumber.cjs --parallel 2 \"src/test/features/**/*.feature\"",
    "test:chromium": "cross-env BROWSER=chromium cucumber-js --config cucumber.cjs \"src/test/features/**/*.feature\"",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js --config cucumber.cjs \"src/test/features/**/*.feature\"",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js --config cucumber.cjs \"src/test/features/**/*.feature\"",
    "debug": "cross-env HEADLESS=false PWDEBUG=1 cucumber-js --config cucumber.cjs \"src/test/features/**/*.feature\"",
    "report:flaky": "node scripts/report-flaky.cjs",
    "allure:clean": "node scripts/allure-report.cjs clean",
    "allure:generate": "node scripts/allure-report.cjs generate",
    "allure:open": "node scripts/allure-report.cjs open",
    "allure:serve": "node scripts/allure-report.cjs serve",
    "test:local": "node scripts/local-app.cjs test",
    "test:local:running": "node scripts/local-app.cjs test-existing",
    "test:local:smoke": "node scripts/local-app.cjs test --tags @local_smoke",
    "test:browsers": "node scripts/run-browsers.cjs",
    "test:browsers:smoke": "node scripts/run-browsers.cjs --profile smoke",
    "test:browsers:contract": "cross-env HAR=replay node scripts/run-browsers.cjs --profile contract"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cucumber/cucumber": "13.3.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "allure-commandline": "2.46.1",
    "allure-cucumberjs": "3.14.0",
    "allure-js-commons": "3.14.0",
    "cross-env": "7.0.3",
    "dotenv": "16.6.1",
    "eslint": "9.39.5",
    "http-server": "14.1.1",
    "prettier": "3.4.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "@colors/colors": "^1.6.1",
    "winston": "^3.19.0"
  },
  "dependencies": {

  }
}
